{
  "name": "hardware-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "measure": "tsx scripts/measure.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.2.0",
    "@fontsource/barlow": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/source-sans-3": "^5.2.0",
    "@google/model-viewer": "^4.4.0",
    "@hocuspocus/provider": "^3.4.0",
    "@hocuspocus/server": "^3.4.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "playwright": "1.64.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "tsx": "^4.20.0",
    "yjs": "^13.6.33",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^5.1.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4",
    "@google/model-viewer": {
      "three": "$three"
    }
  }
}
