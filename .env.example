PORT=4174
OPENAI_API_KEY=
# Only this model has configured pricing and a bounded reservation.
OPENAI_MODEL=gpt-5.4-mini
# Optional absolute interpreter path; default uses named pyenv environment
CAD_PYTHON=
# Local defaults stay loopback. Set explicit listener addresses behind a proxy.
HOST=127.0.0.1
COLLAB_HOST=127.0.0.1
COLLAB_PORT=4175
# Absolute persistent directory for SQLite and build packages
DATA_DIR=
# Build-time same-origin WebSocket path; HTTPS defaults to /collab.
# For HTTP behind a reverse proxy, set this before npm run build.
VITE_COLLAB_PATH=

# One shared execution slot across CAD, analysis, imports and product clips.
HEAVY_WORKER_CONCURRENCY=1
HEAVY_WORKER_QUEUE_LIMIT=8
# 0 preserves local disk behavior. Public host recommendation: 5368709120 (5 GiB).
MIN_FREE_DISK_BYTES=0
# Defaults preserve the existing LOCAL ledger. Set an approved public allowance separately.
AI_BUDGET_USD=50
AI_REQUEST_RESERVATION_USD=1

# Shared by direct proposals and agent roles in this process (1–16; no queue).
AI_PROVIDER_CONCURRENCY=2

# Optional global creation controls. 0 leaves local creation uncapped.
# Choose explicit public limits before deployment; existing designs are never deleted.
MAX_SAVED_DESIGNS=0
DESIGN_CREATIONS_PER_WINDOW=0
DESIGN_CREATION_WINDOW_SECONDS=3600
